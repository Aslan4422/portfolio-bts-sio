# Fichiers que git ne doit JAMAIS envoyer sur GitHub.

# Dépendances (réinstallées avec `npm install`)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Tests
/coverage

# Build Next.js (régénéré à chaque `npm run build`)
/.next/
/out/
/build

# Variables d'environnement : peuvent contenir des secrets.
# Seul le modèle .env.example est versionné.
.env
.env.*
!.env.example

# Vercel
.vercel

# Configuration locale de l'assistant de développement
/.claude/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Journaux de débogage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Système / éditeurs
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
.idea
